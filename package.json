{
  "name": "expense_tracker",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "node ./node_modules/expo/bin/cli start",
    "start:fast": "node ./node_modules/expo/bin/cli start --no-dev --minify",
    "start:tunnel": "node ./node_modules/expo/bin/cli start --tunnel",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "node ./node_modules/expo/bin/cli run:android",
    "android:bundle": "Set-Location android; .\\gradlew.bat bundleRelease",
    "verify:android-size": "node ./scripts/verify-android-size.js",
    "ios": "node ./node_modules/expo/bin/cli run:ios",
    "web": "node ./node_modules/expo/bin/cli start --web",
    "lint": "node ./node_modules/eslint/bin/eslint.js . --no-cache"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.18.18",
    "@shopify/flash-list": "^2.0.2",
    "@supabase/supabase-js": "^2.110.7",
    "expo": "^57.0.0",
    "expo-camera": "~57.0.4",
    "expo-constants": "~57.0.17",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.2",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.9",
    "expo-local-authentication": "~57.0.2",
    "expo-notifications": "~57.0.17",
    "expo-print": "~57.0.1",
    "expo-router": "~57.0.19",
    "expo-secure-store": "~57.0.3",
    "expo-sharing": "~57.0.18",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-chart-kit": "^6.12.0",
    "react-native-confetti-cannon": "^1.5.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.13"
